<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>IronNestGunMod</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <IronNestPath>G:\SteamLibrary\steamapps\common\Iron Nest Heavy Turret Simulator</IronNestPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(IronNestPath)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(IronNestPath)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(IronNestPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- GUI / OnGUI / Rect -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Animator / Animator.SetTrigger -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Mouse.current / Keyboard.current -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Physics.Raycast / RaycastHit -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game-specific classes: ArtilleryReloadController, GunController, etc. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(IronNestPath)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(IronNestPath)\Mods\" />
  </Target>

</Project>
